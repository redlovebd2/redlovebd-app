rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Admin = a user whose UID has a document in the "admins" collection (create it by hand in the Firebase console)
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Advertisement slot on the home screen (only the admin can change it)
    match /ads/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // In-app notifications
    match /notifications/{id} {
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.kind in ['request', 'accepted', 'declined'];
      allow read, delete: if signedIn() && resource.data.toUid == request.auth.uid;
      allow update: if signedIn() && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    // Live chat (pair id = "uidA_uidB" sorted). Messages carry expireAt = +2 minutes and are deleted by clients.
    match /chats/{pair}/messages/{mid} {
      allow read, delete: if signedIn() && request.auth.uid in pair.split('_');
      allow create: if signedIn() && request.auth.uid in pair.split('_')
        && request.resource.data.from == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() <= 500;
    }

    // Private profile (name, phone, email) - owner only
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      // phone tokens for push notifications
      match /devices/{token} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Public donor list - searchable by anyone, contains NO phone/email
    match /donors/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && !('phone' in request.resource.data) && !('email' in request.resource.data);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Public blood requests - NO phone/email
    match /bloodRequests/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && !('phone' in request.resource.data);
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Contact requests. Phone numbers are revealed only after the receiver accepts.
    match /contactRequests/{id} {
      allow read: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'pending' && request.resource.data.toUid != request.auth.uid;
      allow update: if signedIn() && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
        && request.resource.data.status in ['accepted', 'declined'];
      // either party may delete (used by "delete my account")
      allow delete: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);

      match /private/{who} {
        allow delete: if signedIn() && (
          get(/databases/$(database)/documents/contactRequests/$(id)).data.fromUid == request.auth.uid ||
          get(/databases/$(database)/documents/contactRequests/$(id)).data.toUid == request.auth.uid);
        // requester's contact details: written by requester, visible to receiver only once accepted
        allow create: if who == 'requester' && signedIn()
          && getAfter(/databases/$(database)/documents/contactRequests/$(id)).data.fromUid == request.auth.uid;
        allow read: if who == 'requester' && signedIn() && (
          get(/databases/$(database)/documents/contactRequests/$(id)).data.fromUid == request.auth.uid ||
          (get(/databases/$(database)/documents/contactRequests/$(id)).data.toUid == request.auth.uid &&
           get(/databases/$(database)/documents/contactRequests/$(id)).data.status == 'accepted'));
        // receiver's contact details: written when accepting, visible to requester once accepted
        allow create: if who == 'donor' && signedIn()
          && getAfter(/databases/$(database)/documents/contactRequests/$(id)).data.toUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/contactRequests/$(id)).data.status == 'accepted';
        allow read: if who == 'donor' && signedIn() && (
          get(/databases/$(database)/documents/contactRequests/$(id)).data.toUid == request.auth.uid ||
          (get(/databases/$(database)/documents/contactRequests/$(id)).data.fromUid == request.auth.uid &&
           get(/databases/$(database)/documents/contactRequests/$(id)).data.status == 'accepted'));
      }
    }
  }
}
